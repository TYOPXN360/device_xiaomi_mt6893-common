prebuilt_etc {
    name: "fstab.mt6893",
    src: "fstab.mt6893",
    vendor: true,
    ramdisk_available: true,
}

prebuilt_etc {
    name: "init.batterysecret.rc",
    src: "init.batterysecret.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.connectivity.rc",
    src: "init.connectivity.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.fingerprint.rc",
    src: "init.fingerprint.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.mi_thermald.rc",
    src: "init.mi_thermald.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.modem.rc",
    src: "init.modem.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.mt6893.rc",
    src: "init.mt6893.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.mt6893.power.rc",
    src: "init.mt6893.power.rc",
    sub_dir: "init/hw",
    vendor: true,
}

// A17's hardware/mediatek generates its own "init.mt6893.usb.rc" through
// soong_config_variables, which collides with this module's name and install
// path. Keep the device-specific USB configuration, but under a unique name,
// so that both files can coexist in /vendor/etc/init/hw.
prebuilt_etc {
    name: "init.chopin.usb.rc",
    src: "init.chopin.usb.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.sensor_2_0.rc",
    src: "init.sensor_2_0.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.mt6893.rc",
    filename: "ueventd.rc",
    src: "ueventd.mt6893.rc",
    vendor: true,
}
