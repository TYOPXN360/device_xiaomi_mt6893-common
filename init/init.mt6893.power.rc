on init
    # cpuset is deliberately NOT mounted on cgroup v1 here: doing so calls
    # rebind_subsystems() and strips cpuset (and cpu) back out of the v2
    # default hierarchy. cpuset lives on v2, where libprocessgroup writes each
    # task's existing /apps|system/uid_N/pid_M/cpuset.cpus leaf via the
    # CpusetCpus attribute in etc/task_profiles.json (SetAttribute, since
    # JoinCgroup is ignored under v2). The per-state masks that used to be
    # written here - background/system-background/restricted 0-3, foreground
    # 0-6, top-app/camera-daemon 0-7 - are preserved by that overlay instead
    # of by absolute paths. Do not reintroduce /dev/cpuset writes.

    # Reset stune group setting for NNAPI HAL processes
    write /dev/stune/nnapi-hal/schedtune.boost 0
    write /dev/stune/nnapi-hal/schedtune.prefer_idle 0

on post-fs-data
    # zram
    write /sys/block/zram0/comp_algorithm zstd
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/swappiness 100
    write /sys/kernel/mm/swap/vma_ra_enabled false

    # boot time fs tune
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/nr_requests 256
    write /sys/block/sdc/queue/iostats 0
    write /sys/block/sdc/queue/nr_requests 256

    # Reset stune group setting for camera-specific processes
    write /dev/stune/camera-daemon/schedtune.prefer_idle 0
    write /dev/stune/camera-daemon/schedtune.boost 0

    # Configure governor settings for little cluster
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor "schedutil"
    # Configure governor settings for big cluster
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor "schedutil"
    # Configure governor settings for prime cluster
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor "schedutil"

    # create io boost group
    mkdir /dev/stune/io
    chown system system /dev/stune/io
    chown system system /dev/stune/io/tasks
    chmod 0666 /dev/stune/io/tasks

    # Set thermal mode to default
    write /sys/devices/virtual/thermal/thermal_message/sconfig 0

on property:sys.boot_completed=1
    # Enable ZRAM on boot_complete
    swapon_all /vendor/etc/fstab.mt6893

    # end boot time fs tune
    write /sys/block/mmcblk0/queue/iostats 1
    write /sys/block/mmcblk0/queue/nr_requests 128
    write /sys/block/sdc/queue/iostats 1
    write /sys/block/sdc/queue/nr_requests 128

    write /proc/cpufreq/cpufreq_sched_disable 0

    write /dev/stune/foreground/schedtune.prefer_idle 0
    write /dev/stune/top-app/schedtune.prefer_idle 0
    write /dev/stune/rt/schedtune.prefer_idle 0

    write /proc/sys/kernel/sched_migration_cost_ns 200000
    write /proc/perfmgr/boost_ctrl/eas_ctrl/sched_big_task_rotation 1

    # Configure DVFS
    write /sys/kernel/ged/hal/dvfs_margin_value 130
    write /sys/kernel/ged/hal/timer_base_dvfs_margin 798
    write /sys/kernel/ged/hal/loading_base_dvfs_step 4

    # Enable PowerHAL hint processing
    setprop vendor.powerhal.init 1

service vendor.gralloc-4-0 /vendor/bin/hw/android.hardware.graphics.allocator@4.0-service-mediatek
    class hal animation
    interface android.hardware.graphics.allocator@4.0::IAllocator default
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles ProcessCapacityHigh HighPerformance
    override

service vendor.hwcomposer-2-3 /vendor/bin/hw/android.hardware.graphics.composer@2.3-service
    override
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles HighPerformance
