cc_defaults {
    name: "radio-ims-bridge_defaults",
    defaults: ["android.hardware.radio-library.aidl_deps"],
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    shared_libs: [
        "android.hardware.radio-library.compat",
        "android.hardware.radio@1.5",
        "android.hardware.radio@1.6",
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
}

cc_binary {
    name: "radio-ims-bridge",
    defaults: ["radio-ims-bridge_defaults"],
    relative_install_path: "hw",
    init_rc: ["radio-ims-bridge.rc"],
    srcs: ["radio-ims-bridge.cpp"],
    vendor: true,
}
